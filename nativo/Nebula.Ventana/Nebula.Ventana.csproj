<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ventana nativa de Nébula.

    Este es el programa que se abre al hacer doble clic en Nebula.exe: una ventana
    de Windows de verdad (WinForms) que arranca el núcleo (Nebula-nucleo.exe, el
    motor que sirve la biblioteca) y dibuja la interfaz con WebView2.

    Detalles elegidos a propósito:
      · net48            → no hay que instalar ningún runtime: Windows 10/11 ya
                           trae .NET Framework 4.8. El programa ocupa poco.
      · WinExe           → programa de ventana: NUNCA abre la ventana negra de
                           consola (la compilación lo comprueba después).
      · WebView2         → el motor de dibujo que ya viene con Edge en Windows.
      · PlatformTarget   → x64, como el Node de 64 bits que va al lado (el
                           cargador de WebView2 que se copia junto al exe).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Nebula</AssemblyName>
    <RootNamespace>Nebula.Ventana</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>../../branding/icono.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>NU1701;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- el control que dibuja la interfaz dentro de la ventana -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- permite compilar para .NET Framework 4.8 sin tener el paquete de
         referencia instalado (la máquina de integración continua lo agradece) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
